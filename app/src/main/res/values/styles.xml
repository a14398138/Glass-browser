<resources>
 <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:windowIsTranslucent">true</item>
  <item name="android:windowBackground">@android:color/transparent</item>
  <item name="android:windowContentOverlay">@null</item>
  <item name="android:windowNoTitle">true</item>
  <item name="android:backgroundDimEnabled">false</item>
  <item name="android:windowIsFloating">false</item>
  <item name="android:colorAccent">#67E8F9</item>
  <item name="android:statusBarColor">@android:color/transparent</item>
  <item name="android:navigationBarColor">@android:color/transparent</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:windowLightNavigationBar">false</item>
  <item name="android:windowActionModeOverlay">true</item>
 </style>
 <style name="FullscreenTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:windowIsTranslucent">false</item>
  <item name="android:windowIsFloating">false</item>
  <item name="android:windowBackground">#111923</item>
  <item name="android:colorAccent">#67E8F9</item>
  <item name="android:statusBarColor">#111923</item>
  <item name="android:navigationBarColor">#111923</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:windowLightNavigationBar">false</item>
 </style>
</resources>
